import { SurfaceSeparator, FlatSurface, UiSurface } from "ui_surface.slint";
import { UiRadius } from "ui_radius.slint";
import { ScrollView } from "std-widgets.slint";
import { FontAwesomeIcons, ControlStyle } from "common.slint";

// Shared by history and DeskHub; system choices precede the named groups.
export component GroupFilter inherits FlatSurface {
    in property <[string]> model;
    in property <int> system-count: 2;
    in property <bool> enabled: true;
    // An embedded picker shares its enclosing field's outline and focus state.
    in property <bool> embedded: false;
    in property <bool> show-indicator: true;
    in property <length> popup-min-width: 0px;
    in property <length> text-size: 12px;
    in property <int> text-weight: 400;
    in property <color> text-color: #30343b;
    in property <color> normal-background: ControlStyle.surface;
    in property <color> normal-outline-color: UiSurface.edge;
    in property <color> hover-outline-color: UiSurface.hover;
    in property <color> focus-outline-color: UiSurface.focus;
    in-out property <int> current-index: 0;
    out property <bool> has-focus: trigger-focus.has-focus || popup.is-open;
    out property <bool> has-hover: root.enabled && trigger-touch.has-hover && !popup.is-open;
    callback selected(int);
    private property <bool> has-divider: root.system-count > 0 && root.model.length > root.system-count;
    private property <length> list-height: root.model.length * 26px + (root.has-divider ? 6px : 0px);
    private property <length> visible-height: min(root.list-height, 162px);
    private property <length> scroll-y: 0px;
    private property <bool> popup-animation-enabled: false;
    private property <float> popup-progress: 0;

    animate popup-progress {
        duration: 140ms; easing: ease-out;
        enabled: root.popup-animation-enabled;
    }

    width: 155px; height: 28px;
    background: root.embedded ? (root.enabled && trigger-touch.has-hover ? ControlStyle.hover : transparent)
        : !root.enabled ? ControlStyle.disabled
        : trigger-touch.pressed || popup.is-open ? ControlStyle.pressed
        : trigger-touch.has-hover ? ControlStyle.hover : root.normal-background;
    outline-enabled: !root.embedded;
    outline-focused: popup.is-open || trigger-focus.has-focus;
    outline-color: popup.is-open || trigger-focus.has-focus ? root.focus-outline-color
        : trigger-touch.has-hover ? root.hover-outline-color : root.normal-outline-color;
    border-radius: UiRadius.control;
    animate background, outline-color { duration: 100ms; easing: ease-out; }
    forward-focus: trigger-focus;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: popup.is-open;
    accessible-value: root.model[root.current-index];

    function reveal-selection() {
        let top = root.current-index * 26px + (root.has-divider && root.current-index >= root.system-count ? 6px : 0px);
        if top < -root.scroll-y { root.scroll-y = -top; }
        if top + 26px > -root.scroll-y + root.visible-height {
            root.scroll-y = root.visible-height - top - 26px;
        }
        root.scroll-y = clamp(root.scroll-y, min(0px, root.visible-height - root.list-height), 0px);
    }
    function choose(index: int) {
        if !root.enabled || root.model.length == 0 { return; }
        root.current-index = clamp(index, 0, root.model.length - 1);
        root.reveal-selection();
        root.selected(root.current-index);
    }
    public function open-menu() {
        if root.enabled && root.model.length > 0 {
            popup-open-timer.running = false;
            root.popup-animation-enabled = false;
            root.popup-progress = 0;
            root.reveal-selection();
            trigger-focus.focus();
            popup.show();
            popup-open-timer.running = true;
        }
    }
    public function close-menu() { popup.close(); }
    // Defer until the popup has its initial frame; animate its contents only,
    // keeping the native popup bounds and scrolling geometry stable.
    popup-open-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            if popup.is-open {
                root.popup-animation-enabled = true;
                root.popup-progress = 1;
            }
        }
    }
    function handle-key(event: KeyEvent) -> EventResult {
        if !root.enabled { return reject; }
        if event.text == Key.UpArrow { root.choose(root.current-index - 1); return accept; }
        if event.text == Key.DownArrow { root.choose(root.current-index + 1); return accept; }
        if event.text == Key.Return || event.text == " " {
            if popup.is-open { popup.close(); } else { root.open-menu(); }
            return accept;
        }
        if event.text == Key.Escape && popup.is-open { popup.close(); return accept; }
        return reject;
    }
    Text {
        x: root.embedded ? 8px : 10px;
        width: parent.width - (root.show-indicator
            ? (root.embedded ? 26px : 36px) : (root.embedded ? 16px : 20px));
        height: parent.height;
        text: root.model[root.current-index];
        color: root.enabled ? root.text-color : #92979f;
        font-size: root.text-size; font-weight: root.text-weight;
        overflow: elide; vertical-alignment: center;
        accessible-role: none;
    }
    if root.show-indicator: Text {
        x: parent.width - (root.embedded ? 16px : 25px);
        width: root.embedded ? 10px : 16px; height: parent.height;
        text: FontAwesomeIcons.angle-down; font-family: "Font Awesome 6 Free";
        font-weight: 900; font-size: 10px; color: #858c96;
        horizontal-alignment: center; vertical-alignment: center;
        transform-rotation: popup.is-open ? 180deg : 0deg;
        animate transform-rotation { duration: 140ms; easing: ease-out; }
        accessible-role: none;
    }
    trigger-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { return root.handle-key(event); }
        trigger-touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.open-menu(); }
        }
    }
    popup := PopupWindow {
        x: 0px; y: root.height + 4px;
        width: max(root.width, root.popup-min-width); height: root.visible-height + 8px;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;
        popup-focus := FocusScope {
            key-pressed(event) => { return root.handle-key(event); }
            FlatSurface {
                y: (1 - root.popup-progress) * -4px;
                width: parent.width; height: parent.height;
                opacity: root.popup-progress;
                background: white;
                clip: true;
                outline-color: root.normal-outline-color; border-radius: UiRadius.menu;
                ScrollView {
                    x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                    viewport-width: self.width;
                    viewport-height: root.list-height;
                    viewport-y <=> root.scroll-y;
                    Rectangle {
                        width: parent.width; height: root.list-height;
                        if root.has-divider: SurfaceSeparator {
                            x: 6px; y: root.system-count * 26px + 3px;
                            width: parent.width - 12px; height: 1px; outline-color: UiSurface.separator;
                        }
                        for choice[index] in root.model: Rectangle {
                            y: index * 26px + (root.has-divider && index >= root.system-count ? 6px : 0px);
                            width: parent.width; height: 26px; border-radius: UiRadius.control;
                            background: index == root.current-index
                                ? (option-touch.pressed ? ControlStyle.selected-pressed : option-touch.has-hover ? ControlStyle.selected-hover : ControlStyle.selected)
                                : option-touch.pressed ? ControlStyle.pressed : option-touch.has-hover ? ControlStyle.hover : transparent;
                            animate background { duration: 100ms; easing: ease-out; }
                            accessible-role: list-item;
                            accessible-label: choice;
                            Text {
                                x: 8px; width: parent.width - 34px; height: parent.height;
                                text: choice; color: index == root.current-index ? ControlStyle.selected-text : #30343b; font-size: 12px;
                                font-weight: index == root.current-index ? 600 : 400;
                                overflow: elide; vertical-alignment: center;
                                accessible-role: none;
                            }
                            if index == root.current-index: Text {
                                x: parent.width - 24px; width: 16px; height: parent.height;
                                text: FontAwesomeIcons.check; font-family: "Font Awesome 6 Free";
                                font-weight: 900; font-size: 10px; color: ControlStyle.selected-text;
                                horizontal-alignment: center; vertical-alignment: center;
                                accessible-role: none;
                            }
                            option-touch := TouchArea {
                                clicked => { root.choose(index); popup.close(); }
                            }
                        }
                    }
                }
            }
        }
    }
}

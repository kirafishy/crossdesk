// Shared surface shadows use ordinary rectangles and gradients because Slint's
// software renderer does not draw drop-shadow-* effects. Keep layout and hit
// areas unchanged; only the decorative shadow extends beyond the surface.
export global UiShadow {
    out property <color> edge: #20334e;
    out property <color> hover: #315d92;
    out property <color> focus: #3564e3;
    out property <color> error: #d65252;
    out property <color> separator: #20334e14;
}

export component ShadowSurface inherits Rectangle {
    in property <color> shadow-color: UiShadow.edge;
    in property <bool> shadow-enabled: true;
    in property <bool> shadow-focused: false;
    // Small controls need a tighter falloff than cards and dialogs.
    in property <bool> shadow-compact: false;
    border-width: 0px;
    border-top-left-radius: root.border-radius;
    border-top-right-radius: root.border-radius;
    border-bottom-left-radius: root.border-radius;
    border-bottom-right-radius: root.border-radius;

    // Diffuse outwards, with more weight below the surface. A clipped surface
    // keeps a faint inner falloff so native popup edges remain distinguishable.
    for layer in (root.shadow-compact ? 3 : 6): Rectangle {
        visible: root.shadow-enabled;
        private property <length> inset: root.clip ? layer * 0.5px : -(layer + 1) * 1px;
        private property <float> weight: (root.shadow-compact
            ? (layer == 0 ? 0.09 : layer == 1 ? 0.035 : 0.01)
            : (layer == 0 ? 0.09 : layer == 1 ? 0.07
                : layer == 2 ? 0.05 : layer == 3 ? 0.03 : layer == 4 ? 0.015 : 0.005))
            * (root.shadow-focused ? 2.5 : 1);
        x: self.inset; y: self.inset;
        width: max(0px, root.width - 2 * self.inset);
        height: max(0px, root.height - 2 * self.inset);
        border-top-left-radius: max(0px, root.border-top-left-radius - self.inset);
        border-top-right-radius: max(0px, root.border-top-right-radius - self.inset);
        border-bottom-left-radius: max(0px, root.border-bottom-left-radius - self.inset);
        border-bottom-right-radius: max(0px, root.border-bottom-right-radius - self.inset);
        border-width: 1px;
        border-color: @linear-gradient(180deg,
            root.shadow-color.mix(transparent, self.weight * 0.45) 0%,
            root.shadow-color.mix(transparent, self.weight) 100%);
    }
    @children
}

export component ShadowSeparator inherits Rectangle {
    in property <bool> vertical: false;
    in property <color> shadow-color: UiShadow.separator;
    height: 1px;

    Rectangle {
        x: root.vertical ? -2px : 0px;
        y: root.vertical ? 0px : -1px;
        width: root.vertical ? 5px : root.width;
        height: root.vertical ? root.height : 6px;
        background: root.vertical
            ? @linear-gradient(90deg, transparent 0%, root.shadow-color 50%, transparent 100%)
            : @linear-gradient(180deg, transparent 0%, root.shadow-color 50%, transparent 100%);
    }
}
